# Kabu Station API Settings
# 口座開設後に設定してください
KABU_API_PASSWORD=your_api_password_here
KABU_API_PORT=18080
KABU_API_HOST=localhost

# Google Gemini API Settings
# https://aistudio.google.com/ で取得したキーを貼り付けてください
GEMINI_API_KEY=your_gemini_api_key_here

# System Settings
# True: テスト用データを使用, False: 本番APIに接続
MOCK_MODE=True
