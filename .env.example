# Kabu Station API Settings
# 口座開設後に設定してください
KABU_API_PASSWORD=your_api_password_here
KABU_API_PORT=18080
KABU_API_HOST=localhost

# Google Gemini API Settings
# https://aistudio.google.com/ で取得したキーを貼り付けてください
GEMINI_API_KEY=your_gemini_api_key_here
# 使用するモデル (例: gemini-2.0-flash, gemini-2.0-flash-thinking-exp-01-21)
GEMINI_MODEL_ID=gemini-2.0-flash

# System Settings
# True: テスト用データを使用, False: 本番APIに接続
MOCK_MODE=True

# Local AI (Ollama) Settings
# Docker環境などでホストのOllamaに接続する場合に指定 (デフォルトは自動判別)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api
